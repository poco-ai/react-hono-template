{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		// drizzle-orm@rc 的类型声明需要 skipLibCheck（官方模板同样如此）
		"skipLibCheck": true,
		// workers 运行时类型由 `wrangler types` 生成的 worker-configuration.d.ts 提供
		// node 类型仅用于 drizzle.config.ts 里的 process.env
		"types": ["node"]
	}
}
