{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "react-hono-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "react-hono-db",
			"database_id": "92f43dc5-a6b1-4917-bd76-7d6856d53b36",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER_FREE",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMITER_PRO",
			"namespace_id": "1002",
			"simple": {
				"limit": 600,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMITER_AI_FREE",
			"namespace_id": "1003",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMITER_AI_PRO",
			"namespace_id": "1004",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "104dbf8a6fae459682493aee112b46ed"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "WEBHOOK_QUEUE",
				"queue": "react-hono-webhooks"
			}
		],
		"consumers": [
			{
				"queue": "react-hono-webhooks",
				"max_batch_size": 10,
				// Matches WEBHOOK_MAX_ATTEMPTS. `attempts` starts at 1 and includes the current delivery.
				"max_retries": 2
			}
		]
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"vars": {
		"AI_ENABLED": "true",
		"AI_PROVIDER": "openai-compatible",
		"AI_BASE_URL": "https://api.siliconflow.cn/v1",
		"AI_MODEL": "deepseek-ai/DeepSeek-V4.1-Flash",
		"AI_MODEL_ALLOWLIST": "deepseek-ai/DeepSeek-V4.1-Flash",
		"AI_MAX_STEPS": "8",
		"AI_MAX_OUTPUT_TOKENS": "2048",
		"APP_WEB_URL": "https://react-hono-web.poco-ai.workers.dev",
		"BETTER_AUTH_URL": "https://react-hono-api.poco-ai.workers.dev",
		"BILLING_MOCK_MODE": "true",
		"MCP_ENABLED": "true",
		"MCP_RESOURCE": "https://react-hono-api.poco-ai.workers.dev/mcp",
		"MCP_LOGIN_PAGE": "https://react-hono-web.poco-ai.workers.dev/login",
		"MCP_CONSENT_PAGE": "https://react-hono-web.poco-ai.workers.dev/consent",
		"MCP_DCR_ENABLED": "false",
		"S3_ENDPOINT": "https://e3299b6523b3e90e23ce76f0004eda78.r2.cloudflarestorage.com",
		"S3_REGION": "auto",
		"S3_BUCKET": "react-hono-attachments"
	}
}
