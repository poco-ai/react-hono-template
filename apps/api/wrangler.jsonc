{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "react-hono-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "react-hono-db",
			"database_id": "b6335bcc-3857-44d8-b54d-8a4cb76ebcfc",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER_FREE",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMITER_PRO",
			"namespace_id": "1002",
			"simple": {
				"limit": 600,
				"period": 60
			}
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "fb4c47a58af04d05bf5b5e351e24feb2"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "WEBHOOK_QUEUE",
				"queue": "react-hono-webhooks"
			}
		],
		"consumers": [
			{
				"queue": "react-hono-webhooks",
				"max_batch_size": 10,
				// Matches WEBHOOK_MAX_ATTEMPTS. `attempts` starts at 1 and includes the current delivery.
				"max_retries": 2
			}
		]
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
	// "vars": { "ENVIRONMENT": "production" }
}
