{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "react-hono-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "react-hono-db",
			"database_id": "b6335bcc-3857-44d8-b54d-8a4cb76ebcfc",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	]
	// 以后需要 KV / R2 等 binding 时在这里声明，例如：
	// "vars": { "ENVIRONMENT": "production" }
	// secrets 用 `bunx wrangler secret put <NAME>` 设置，不要写进这个文件
}
