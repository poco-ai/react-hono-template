# Bun server (PostgreSQL + Redis). Copy to apps/api/.env for `bun run dev:server`.
# Docker Compose overrides connection strings and the browser-facing URLs.

SQL_DIALECT=postgres
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
REDIS_URL=redis://127.0.0.1:6379

PORT=8787
HOST=0.0.0.0

BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
APP_WEB_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173

# S3-compatible storage. Region must be a real region such as us-east-1.
# R2's `auto` is only for the Cloudflare runtime.
S3_ENDPOINT=http://127.0.0.1:9000
# Only needed if browsers reach S3 at a different address from the API.
# S3_SIGNING_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

BILLING_MOCK_MODE=true

# Optional. Set all of a group, or none.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=
# AI_ENABLED=false
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# MCP_ENABLED=false
