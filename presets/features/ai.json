{
	"id": "ai",
	"tier": 4,
	"dependsOn": ["core", "capabilities", "issues", "projects"],
	"softDependsOn": ["billing"],
	"env": {
		"optional": [
			"AI_ENABLED",
			"AI_PROVIDER",
			"AI_BASE_URL",
			"AI_API_KEY",
			"AI_MODEL",
			"AI_MODEL_ALLOWLIST",
			"AI_MAX_STEPS",
			"AI_MAX_OUTPUT_TOKENS"
		],
		"mockFlag": "AI_PROVIDER=mock"
	},
	"claims": [
		"apps/api/src/ai/**",
		"apps/api/src/controllers/ai.controller.ts",
		"apps/api/src/dao/ai-conversation.dao.ts",
		"apps/api/src/dao/ai-message.dao.ts",
		"apps/api/src/dao/ai-tool-call.dao.ts",
		"apps/api/src/dao/ai-usage.dao.ts",
		"apps/api/src/dao/org-ai-settings.dao.ts",
		"apps/api/src/dto/ai.dto.ts",
		"apps/api/src/middleware/ai.ts",
		"apps/api/src/routes/ai.ts",
		"apps/api/src/services/ai-chat.service.ts",
		"apps/api/src/services/ai-conversation.service.ts",
		"apps/api/src/services/ai-usage.service.ts",
		"apps/api/src/services/org-ai-settings.service.ts",
		"apps/web/src/features/ai/**",
		"packages/shared/src/schemas/ai.ts"
	]
}
