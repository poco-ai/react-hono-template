{
	"id": "ai",
	"tier": 4,
	"dependsOn": [
		"core",
		"capabilities",
		"issues",
		"projects",
		"comments",
		"labels",
		"statuses",
		"activities",
		"relations",
		"views",
		"cycles",
		"project-updates",
		"search",
		"favorites",
		"templates",
		"recurrences"
	],
	"softDependsOn": ["billing"],
	"env": {
		"optional": [
			"AI_ENABLED",
			"AI_PROVIDER",
			"AI_BASE_URL",
			"AI_API_KEY",
			"AI_MODEL",
			"AI_MODEL_ALLOWLIST",
			"AI_MAX_STEPS",
			"AI_MAX_OUTPUT_TOKENS"
		],
		"mockFlag": "AI_PROVIDER=mock"
	},
	"claims": [
		"apps/api/src/features/ai/**",
		"apps/web/src/features/ai/**",
		"packages/shared/src/schemas/ai.ts",
		"apps/web/src/routes/_auth/orgs/$orgId/ai.*",
		"apps/web/src/routes/_auth/orgs/$orgId/settings/ai.tsx",
		"apps/web/src/pages/org-settings/ai.tsx",
		"apps/web/src/i18n/locales/en/ai.ts",
		"apps/web/src/i18n/locales/zh/ai.ts",
		"apps/web/src/components/org-conversation-row.tsx",
		"docs/AI与MCP.md"
	]
}
