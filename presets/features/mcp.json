{
	"id": "mcp",
	"tier": 4,
	"dependsOn": ["core", "capabilities", "ai"],
	"softDependsOn": ["api-keys"],
	"env": {
		"optional": [
			"MCP_ENABLED",
			"MCP_RESOURCE",
			"MCP_LOGIN_PAGE",
			"MCP_CONSENT_PAGE",
			"MCP_DCR_ENABLED"
		]
	},
	"claims": [
		"apps/api/src/features/mcp/**",
		"apps/web/src/features/mcp/**",
		"apps/web/src/routes/consent.tsx",
		"apps/web/src/routes/_auth/orgs/$orgId/settings/mcp.tsx",
		"apps/web/src/pages/consent.tsx",
		"apps/web/src/pages/org-settings/mcp.tsx",
		"apps/web/src/i18n/locales/en/mcp.ts",
		"apps/web/src/i18n/locales/zh/mcp.ts"
	]
}
