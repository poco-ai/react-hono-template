{
	"id": "attachments",
	"tier": 2,
	"dependsOn": ["core", "issues", "comments", "projects"],
	"softDependsOn": ["billing", "webhooks"],
	"env": {
		"optional": [
			"S3_ENDPOINT",
			"S3_REGION",
			"S3_ACCESS_KEY_ID",
			"S3_SECRET_ACCESS_KEY",
			"S3_BUCKET",
			"S3_SIGNING_ENDPOINT"
		]
	},
	"claims": [
		"apps/api/src/features/attachments/**",
		"apps/web/src/features/attachments/**",
		"packages/shared/src/schemas/attachment.ts",
		"packages/shared/src/schemas/media.ts"
	]
}
