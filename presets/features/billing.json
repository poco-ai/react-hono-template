{
	"id": "billing",
	"tier": 3,
	"dependsOn": ["core", "webhooks", "projects"],
	"env": {
		"optional": [
			"STRIPE_SECRET_KEY",
			"STRIPE_PRICE_ID",
			"STRIPE_WEBHOOK_SECRET"
		],
		"mockFlag": "BILLING_MOCK_MODE=true"
	},
	"claims": [
		"apps/api/src/features/billing/**",
		"apps/web/src/features/billing/**",
		"packages/shared/src/plans.ts",
		"packages/shared/src/quota.ts",
		"packages/shared/src/schemas/billing.ts",
		"apps/web/src/routes/_auth/orgs/$orgId/settings/billing.tsx",
		"apps/web/src/pages/org-settings/billing.tsx",
		"apps/web/src/components/quota-error.tsx",
		"apps/web/src/i18n/locales/en/billing.ts",
		"apps/web/src/i18n/locales/zh/billing.ts",
		"apps/web/src/i18n/locales/en/quota.ts",
		"apps/web/src/i18n/locales/zh/quota.ts"
	],
	"softDependsOn": ["attachments"]
}
