{
	"id": "billing",
	"tier": 3,
	"dependsOn": ["core", "webhooks", "projects"],
	"env": {
		"optional": [
			"STRIPE_SECRET_KEY",
			"STRIPE_PRICE_ID",
			"STRIPE_WEBHOOK_SECRET"
		],
		"mockFlag": "BILLING_MOCK_MODE=true"
	},
	"claims": [
		"apps/api/src/features/billing/**",
		"apps/web/src/features/billing/**",
		"packages/shared/src/plans.ts",
		"packages/shared/src/quota.ts",
		"packages/shared/src/schemas/billing.ts"
	],
	"softDependsOn": ["attachments"]
}
