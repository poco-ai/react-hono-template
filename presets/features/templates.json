{
	"id": "templates",
	"label": "Issue templates",
	"description": "Reusable issue templates",
	"tier": 2,
	"dependsOn": ["core", "issues", "projects", "labels", "statuses"],
	"claims": [
		"apps/api/src/features/templates/**",
		"apps/web/src/features/templates/**",
		"packages/shared/src/schemas/issue-template.ts",
