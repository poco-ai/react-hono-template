{
	"name": "react-hono-template",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "biome lint .",
		"check": "biome ci .",
		"test": "bun test packages/create-app/tests && bun test apps/api/tests && bun run --cwd apps/web test",
		"format": "biome format --write .",
		"typecheck": "turbo typecheck",
		"create-app": "bun packages/create-app/src/index.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"turbo": "^2.9.18",
		"typescript": "~6"
	},
	"packageManager": "bun@1.4.2",
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"engines": {
		"node": ">=20"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"presets"
	]
}
